<div class="cbp-slider">
  <ul class="cbp-slider-wrap">
    {% for image in images %}
      <li class="cbp-slider-item">
        {% set link = image['#item'].getValue()['title'] %}
        {% if link is not empty and (link starts with 'http://' or link starts with 'https://') %}
        <a class="a" href="{{ image['#item'].getValue()['title'] }}">{{ image }}</a>
        {% else %}
          {{ image }}
        {% endif %}
        <div class="img-alt">
          {{ image['#item'].getValue()['alt'] }}
        </div>
      </li>
    {% endfor %}
  </ul>
</div>
