{
    "name": "drupal/legacy-project",
    "description": "Project template for Drupal 8 projects with composer following drupal/drupal layout",
    "type": "project",
    "license": "GPL-2.0-or-later",
    "homepage": "https://www.drupal.org/project/drupal",
    "support": {
        "docs": "https://www.drupal.org/docs/user_guide/en/index.html",
        "chat": "https://www.drupal.org/node/314178"
    },
    "repositories": [
        {
            "type": "composer",
            "url": "https://packages.drupal.org/8"
        }
    ],
    "require": {
        "commerceguys/addressing": "^2.2.4",
        "commerceguys/intl": "^2.0.7",
        "composer/installers": "^1.12",
        "drupal/address": "^2.0.4",
        "drupal/addtoany": "^2.0.7",
        "drupal/admin_toolbar": "^3.6.1",
        "drupal/asset_injector": "^2.21",
        "drupal/backup_migrate": "^5.1",
        "drupal/better_exposed_filters": "^6.0.6",
        "drupal/block_class": "^3",
        "drupal/block_id": "^2.0.5",
        "drupal/body_node_id_class": "^2.0.1",
        "drupal/captcha": "^1.16",
        "drupal/colorbox": "^2.1.4",
        "drupal/colorbox_inline": "^2.0",
        "drupal/colorbox_load": "^1.3",
        "drupal/commerce": "^2.40",
        "drupal/commerce_variation_cart_form": "^1.5",
        "drupal/config_update": "^2.0@alpha",
        "drupal/core-composer-scaffold": "^10.5.1",
        "drupal/core-project-message": "^10.5.1",
        "drupal/core-recommended": "^10.5.1",
        "drupal/core-vendor-hardening": "^8.9.20",
        "drupal/crop": "^2.4",
        "drupal/ctools": "^3.15",
        "drupal/devel": "^5.4",
        "drupal/duplicate_role": "^1.4",
        "drupal/embed": "^1.10",
        "drupal/entity": "^1.6",
        "drupal/entity_browser": "^2.13",
        "drupal/entity_reference_revisions": "^1.12",
        "drupal/extlink": "^2.0.4",
        "drupal/field_display_label": "^1.3",
        "drupal/field_formatter_class": "^1.8",
        "drupal/file_browser": "^1.4",
        "drupal/file_entity": "^2.1@beta",
        "drupal/fivestar": "^1.0@alpha",
        "drupal/flag": "^4.0@beta",
        "drupal/fontyourface": "^4.0",
        "drupal/google_analytics": "^4.0",
        "drupal/iframe": "^2.24",
        "drupal/image_effects": "^3.6",
        "drupal/image_resize_filter": "^1.2",
        "drupal/imce": "^3.1.3",
        "drupal/inline_entity_form": "^1.0@RC",
        "drupal/jquery_ui_slider": "^2.1",
        "drupal/libraries": "^4.1",
        "drupal/login_redirect_per_role": "^1.11",
        "drupal/mailchimp": "^2.2.5",
        "drupal/md_slider": "^1.5.4",
        "drupal/menu_per_role": "^1.8",
        "drupal/metatag": "^2.1.1",
        "drupal/module_filter": "^5.0.4",
        "drupal/n1ed": "^2.78",
        "drupal/ng_lightbox": "^2.1@beta",
        "drupal/nocurrent_pass": "^1.3",
        "drupal/password_eye": "^2.2",
        "drupal/pathauto": "^1.13",
        "drupal/pdf": "^1.2",
        "drupal/profile": "^1.12",
        "drupal/quick_node_clone": "^1.22",
        "drupal/quicktabs": "^3.0@alpha",
        "drupal/responsive_menu": "^4.4.5",
        "drupal/save_edit": "^1.9",
        "drupal/shortcode": "^2.0.3",
        "drupal/simple_iframe": "^1.0@RC",
        "drupal/simple_media_bulk_upload": "^2.0",
        "drupal/simplify_menu": "^3.3",
        "drupal/smart_date": "^4.2.4",
        "drupal/smtp": "^1.4",
        "drupal/state_machine": "^1.13",
        "drupal/stringoverrides": "1.x-dev",
        "drupal/tb_megamenu": "^1.9",
        "drupal/token": "^1.15",
        "drupal/twig_debugger": "^1.1.4",
        "drupal/twig_field_value": "^2.0.5",
        "drupal/twig_tweak": "^3.4.1",
        "drupal/tzfield": "^1.12",
        "drupal/vefl": "^3.2",
        "drupal/views_bootstrap": "^4.5",
        "drupal/views_bulk_edit": "^3.0",
        "drupal/views_bulk_operations": "^4.3.4",
        "drupal/views_filters_populate": "^2.2",
        "drupal/views_flipped_table": "^2.0.3",
        "drupal/views_load_more": "^2.0@alpha",
        "drupal/views_year_filter": "^2.1.6",
        "drupal/webform": "^6.2.9",
        "drupal/xmlsitemap": "^1.5",
        "drupal/yaml_editor": "^1.3",
        "drush/drush": "^12.5.3",
        "phpmailer/phpmailer": "^6.10"
    },
    "conflict": {
        "drupal/drupal": "*"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "composer/installers": true,
            "drupal/core-composer-scaffold": true,
            "drupal/core-project-message": true,
            "drupal/core-vendor-hardening": true,
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    },
    "extra": {
        "drupal-scaffold": {
            "locations": {
                "web-root": "./"
            }
        },
        "installer-paths": {
            "core": [
                "type:drupal-core"
            ],
            "libraries/{$name}": [
                "type:drupal-library"
            ],
            "modules/contrib/{$name}": [
                "type:drupal-module"
            ],
            "profiles/contrib/{$name}": [
                "type:drupal-profile"
            ],
            "themes/contrib/{$name}": [
                "type:drupal-theme"
            ],
            "drush/Commands/contrib/{$name}": [
                "type:drupal-drush"
            ],
            "modules/custom/{$name}": [
                "type:drupal-custom-module"
            ],
            "themes/custom/{$name}": [
                "type:drupal-custom-theme"
            ]
        },
        "drupal-core-project-message": {
            "include-keys": [
                "homepage",
                "support"
            ],
            "post-create-project-cmd-message": [
                "<bg=blue;fg=white>                                                         </>",
                "<bg=blue;fg=white>  Congratulations, you’ve installed the Drupal codebase  </>",
                "<bg=blue;fg=white>  from the drupal/legacy-project template!               </>",
                "<bg=blue;fg=white>                                                         </>",
                "",
                "<bg=yellow;fg=black>Next steps</>:",
                "  * Install the site: https://www.drupal.org/docs/8/install",
                "  * Read the user guide: https://www.drupal.org/docs/user_guide/en/index.html",
                "  * Get support: https://www.drupal.org/support",
                "  * Get involved with the Drupal community:",
                "      https://www.drupal.org/getting-involved",
                "  * Remove the plugin that prints this message:",
                "      composer remove drupal/core-project-message"
            ]
        }
    }
}
